[Unit]
Description=universal-web-api #3 (127.0.0.1:8201 -> CDP 9224)
After=chrome-webapi3.service
Wants=chrome-webapi3.service

[Service]
User=webapi
Group=webapi
WorkingDirectory=/opt/uwa3/universal-web-api
Environment=DISPLAY=:99
Environment=LANG=zh_CN.UTF-8
Environment=PYTHONUTF8=1
Environment=PYTHONIOENCODING=utf-8
ExecStart=/opt/uwa/venv/bin/python main.py
Restart=always
RestartSec=5
MemoryMax=600M
StandardOutput=append:/home/webapi/logs/uwa3.log
StandardError=append:/home/webapi/logs/uwa3.log

[Install]
WantedBy=multi-user.target
