# ds-pool 配置（systemd EnvironmentFile）—— 权限 600，含密钥，勿外传
POOL_HOST=0.0.0.0
POOL_PORT=8288
POOL_TOKENS=<在此填写>
DS_POOL_CTL_TOKEN=<在此填写>
POOL_CTL_TCP_PORT=8399
UPSTREAM_TOKEN=<在此填写>
UPSTREAM_1=ds1|http://127.0.0.1:8199|chat.deepseek.com|cohen-p1|<UWA令牌>
UPSTREAM_2=ds2|http://127.0.0.1:8200|chat.deepseek.com|bel-p2|<UWA令牌>
UPSTREAM_3=ds3|http://127.0.0.1:8201|chat.deepseek.com|upm-p3|<UWA令牌>
UPSTREAM_MODELS=chat.deepseek.com,deepseek,www.chat.deepseek.com
MODEL_ALIAS=deepseek-chat=chat.deepseek.com,deepseek-reasoner=chat.deepseek.com,deepseek-v4-pro=chat.deepseek.com,deepseek-v4.1-flash=chat.deepseek.com,deepseek-v4-flash=chat.deepseek.com
DEFAULT_MODEL=chat.deepseek.com
UPSTREAM_SERVICES=ds1=uwa-webapi,chrome-webapi,ds2=uwa-webapi2,chrome-webapi2,ds3=uwa-webapi3,chrome-webapi3
PER_UPSTREAM_CONCURRENCY=1
COOLDOWN=300
QUEUE_TIMEOUT=180
FIRST_BYTE_TIMEOUT=90
KEEPALIVE=12
STATS_FILE=/var/lib/ds-pool/stats.json
STATS_FLUSH_SECS=15
USAGE_KEEP_DAYS=8
CTL_SERVICES=uwa-webapi,chrome-webapi,uwa-webapi2,chrome-webapi2,uwa-webapi3,chrome-webapi3,ds-pool
CTL_MIN_INTERVAL=3

# ---- 会话粘滞 + 增量发送（dsess.py）----
# DS_SESS_INCREMENT=0 可一键退回「每请求全量新建对话」的旧行为
# 预设名默认「续用」，写在 dsess.py 里；systemd EnvironmentFile 不放中文，避免编码歧义
DS_SESS_INCREMENT=1
DS_SESS_TTL=1800
DS_SESS_IMAGE_CHARS=2000  # 一张图/文件在 est 里的名义字数

# ---- 反代层语言指令注入（方案B：治「对话偶尔回英文」）----
# 非空时作为第一条 system 消息注入到每次请求；空 = 不注入。
# pool.env 是 UTF-8，可直接写中文：POOL_LANG_DIRECTIVE=请始终使用简体中文回复。
# 注意：改这里后要重启 ds-pool；已有网页会话首轮指纹会变，触发一次全量重建属正常。
POOL_LANG_DIRECTIVE=
