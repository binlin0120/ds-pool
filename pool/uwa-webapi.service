[Unit]
Description=universal-web-api (OpenAI-compatible bridge, localhost only)
After=chrome-webapi.service network-online.target
Wants=chrome-webapi.service

[Service]
User=webapi
Group=webapi
WorkingDirectory=/opt/uwa/universal-web-api-main
Environment=DISPLAY=:99
Environment=LANG=zh_CN.UTF-8
Environment=PYTHONUTF8=1
Environment=PYTHONIOENCODING=utf-8
ExecStart=/opt/uwa/venv/bin/python main.py
Restart=always
RestartSec=5
MemoryMax=700M
StandardOutput=append:/home/webapi/logs/uwa.log
StandardError=append:/home/webapi/logs/uwa.log

[Install]
WantedBy=multi-user.target
